# ---------------------------------------------------------------
# .gitignore for CMCN — Cross-Modal Fake News Detection
# ---------------------------------------------------------------

# ── Dataset & Images (too large for GitHub) ───────────────────────
data/
dataset/
Fakeddit/
images/
*.tsv
subsets/

# ── Cached image files ────────────────────────────────────────────
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp

# ── Model checkpoints & weights (too large) ───────────────────────
*.pt
*.pth
*.bin
*.safetensors
*.h5
*.ckpt
outputs/
checkpoints/

# ── Cached CSV files (generated by notebook 01) ───────────────────
*_cached.csv

# ── Python cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Virtual environments ──────────────────────────────────────────
.env
.venv
env/
venv/
ENV/

# ── Jupyter internals ─────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── HuggingFace model cache (auto-downloaded) ─────────────────────
.cache/
huggingface/

# ── Logs & temporary files ────────────────────────────────────────
*.log
*.tmp
*.temp
logs/
runs/

# ── IDE & OS files ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Archive files ─────────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.rar
